## ArxivDigest environment settings — copy this file to .env and fill in what you use.

##################################################################################################
# DO NOT COMMIT YOUR API KEYS OR EMAIL ADDRESS TO YOUR REPOSITORY (.env is git-ignored)
##################################################################################################

## LLM API keys — set at least one (provider "auto" picks Anthropic > OpenAI > Gemini)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

## EMAIL SETTINGS (SciML digest, SMTP) — e.g. Gmail address + app password
## https://support.google.com/accounts/answer/185833
MAIL_USERNAME=
MAIL_PASSWORD=
TO_EMAIL=
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=465

## Legacy digest (src/action.py) only
SENDGRID_API_KEY=
FROM_EMAIL=
